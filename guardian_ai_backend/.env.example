# ==========================================
# PROVO GUARD - BACKEND CONFIGURATION TEMPLATE
# ==========================================

# Port to run the Express API server on
PORT=8080

# Environment mode (development or production)
NODE_ENV=development

# JWT Secret key for signing/verifying authentication tokens
JWT_SECRET=guardian_ai_super_secret_jwt_key_2026

# Google Gemini API Key
# Get a free key from: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# -------------------------------------------------------------
# Firebase Firestore Configuration (Optional - Spark Plan is Free)
# -------------------------------------------------------------
# If left empty/undefined, the backend runs in a free offline Mock/In-Memory Firestore mode.
# To connect to a real, free Cloud Firestore instance:
# 1. Create a Firebase Project (Spark Plan - Free) at https://console.firebase.google.com/
# 2. Go to Project Settings -> Service Accounts -> Generate New Private Key
# 3. Minify and paste the generated JSON file contents into FIREBASE_SERVICE_ACCOUNT below.
# 4. Paste your Storage Bucket url (e.g. your-app.appspot.com) into FIREBASE_STORAGE_BUCKET below.

FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=
